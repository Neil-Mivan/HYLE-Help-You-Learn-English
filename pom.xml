<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>
  <groupId>org.hyle</groupId>
  <artifactId>hyle</artifactId>
  <version>0.2.0-SNAPSHOT</version>
  <properties>
    <java.version>17</java.version>
    <npm.executable>npm</npm.executable>
  </properties>
  <profiles>
    <profile>
      <id>windows-npm</id>
      <activation><os><family>Windows</family></os></activation>
      <properties><npm.executable>npm.cmd</npm.executable></properties>
    </profile>
  </profiles>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
  </dependencies>
  <build>
    <finalName>hyle</finalName>
    <resources>
      <resource>
        <directory>${project.basedir}/frontend/dist</directory>
        <targetPath>static</targetPath>
        <includes><include>index.html</include><include>assets/**</include></includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <executable>${npm.executable}</executable>
          <workingDirectory>${project.basedir}/frontend</workingDirectory>
        </configuration>
        <executions>
          <execution>
            <id>install-frontend</id><phase>generate-resources</phase><goals><goal>exec</goal></goals>
            <configuration><arguments><argument>ci</argument><argument>--prefer-offline</argument><argument>--no-audit</argument><argument>--no-fund</argument></arguments></configuration>
          </execution>
          <execution>
            <id>build-vue</id><phase>generate-resources</phase><goals><goal>exec</goal></goals>
            <configuration><arguments><argument>run</argument><argument>build</argument></arguments></configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
