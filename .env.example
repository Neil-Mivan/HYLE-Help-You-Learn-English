# Copy this file to .env.local or run configure-api.cmd.
HOST=127.0.0.1
# Public friend deployment: set to 1 so visitors must use their own Key even if the server has one.
CLEAR_READING_REQUIRE_PERSONAL_KEY=0
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-mt-lite
DASHSCOPE_CONTEXT_MODEL=qwen3.5-flash
# Strongest first. When a model's free tier is exhausted or temporarily unavailable, the server tries the next one.
DASHSCOPE_ANALYSIS_MODELS=qwen3.7-max,qwen3.7-max-2026-06-08,qwen3.7-max-2026-05-20,qwen3.7-max-2026-05-17,qwen3.7-plus,qwen3.7-plus-2026-05-26,qwen3.5-flash
